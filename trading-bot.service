[Unit]
Description=Binance Trading Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-bot
ExecStart=/home/ubuntu/trading-bot/.venv/bin/python main.py paper
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/trading-bot/trading_bot.log
StandardError=append:/home/ubuntu/trading-bot/trading_bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
